# HTTPS automático (Let's Encrypt) vía Caddy.
# Dominios vienen de .env.production → ADMIN_HOST / API_HOST
# DNS A de ambos hostnames debe apuntar a la IP pública de la VM.

{
	email {$ACME_EMAIL}
}

{$ADMIN_HOST} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy admin:3000
}

{$API_HOST} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# WebSockets (/realtime) y long-polling: Caddy los pasa por defecto
	reverse_proxy api:3001
}
