generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Una fila por deployment (template single-business).
/// Se mantiene businessId en el resto del schema para no romper relaciones.
model Business {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?
  type              String   @default("OTHER")
  timezone          String   @default("America/Argentina/Buenos_Aires")
  language          String   @default("es")
  address           String?
  phone             String?
  whatsapp          String?
  email             String?
  website           String?
  instagram         String?
  /// Link de Google para pedir reseñas (Maps / ficha del negocio).
  googleReviewsUrl  String?
  additionalInfo    String?
  /// @deprecated Preferir BusinessHour. Se mantiene por compatibilidad.
  openingHours      Json?
  /// Mensajes configurables: welcome, offline, handoff, appointmentConfirmation, etc.
  defaultMessages   Json?
  rules             Json?
  dailyRequestLimit Int      @default(1000)
  dailyTokenLimit   Int      @default(500000)
  allowedModels     String[] @default(["gpt-4.1-mini"])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agentConfigs    AgentConfig[]
  conversations   Conversation[]
  knowledgeBases  KnowledgeBase[]
  toolConfigs     ToolConfig[]
  integrations    Integration[]
  automations     Automation[]
  memories        Memory[]
  agentExecutions AgentExecution[]
  users           User[]
  leads           Lead[]
  payments        Payment[]
  servicePasses   ServicePass[]
  businessHours   BusinessHour[]
  services        Service[]
  classTemplates  ClassTemplate[]
  appointments    Appointment[]
  whatsappConfig  WhatsAppConfig?
  googleCalendarConfig GoogleCalendarConfig?
  webChatConfig        WebChatConfig?
  brandingConfig       BrandingConfig?
  socialContentConfig  SocialContentConfig?
  appointmentReminderConfig AppointmentReminderConfig?
  leadLifecycleConfig  LeadLifecycleConfig?
  adminNotifyConfig    AdminNotifyConfig?
  leadFollowUps        LeadFollowUp[]
  leadEvents           LeadEvent[]
  generatedContents    GeneratedContent[]
  contentGenerationExecutions ContentGenerationExecution[]
  contentPublications  ContentPublication[]
  /// Profile `_id` de Zernio (un profile por tenant).
  zernioProfileId      String?
  socialConnections    SocialConnection[]
  audioAssets          AudioAsset[]
  creditMovements      ClassCreditMovement[]

  @@map("businesses")
}

model AgentConfig {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  provider           String   @default("openai")
  model              String
  /// Instrucciones avanzadas / system prompt completo (opcional en UI).
  systemPrompt       String
  /// Tono visible al negocio: professional_warm | formal | friendly | casual | custom
  tone               String   @default("professional_warm")
  /// "Cómo debe comportarse tu asistente" (lenguaje no técnico).
  customInstructions String?
  personality        String?
  temperature        Float    @default(0.3)
  maxTokens          Int      @default(2048)
  maxSteps           Int      @default(8)
  knowledgeBaseId    String?
  knowledgeBase      KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  enabledTools       String[]
  enabledChannels    String[]
  memoryStrategy     Json?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations Conversation[]

  @@index([businessId])
  @@map("agent_configs")
}

/// Horarios por día. dayOfWeek: 0=lunes … 6=domingo.
/// ranges: [{ "start": "09:00", "end": "13:00" }, { "start": "14:00", "end": "18:00" }]
model BusinessHour {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  isClosed   Boolean  @default(false)
  ranges     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_hours")
}

model ClassCreditMovement {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicePassId String?
  servicePass   ServicePass? @relation(fields: [servicePassId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type          String // PURCHASE|CONSUMPTION|MANUAL_ADJUSTMENT|REFUND|EXPIRATION
  amount        Int
  reason        String?
  createdAt     DateTime     @default(now())

  @@index([businessId, userId])
  @@index([servicePassId])
  @@index([appointmentId])
  @@map("class_credit_movements")
}

model Service {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  durationMinutes     Int      @default(30)
  price               Decimal? @db.Decimal(12, 2)
  priceDescription    String?
  enabled             Boolean  @default(true)
  requiresAppointment Boolean  @default(true)
  sortOrder           Int      @default(0)
  /// 1 = servicio de una vez. >1 = pack de N clases.
  sessionCount        Int      @default(1)
  /// 1 = turno exclusivo. >1 = clase grupal con ese cupo.
  capacity            Int      @default(1)
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments      Appointment[]
  generatedContents GeneratedContent[]
  payments          Payment[]
  passes            ServicePass[]
  classTemplates    ClassTemplate[]

  @@index([businessId, enabled])
  @@map("services")
}

/// Grilla semanal de clases (un salón: un horario = un servicio).
model ClassTemplate {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// 0=lunes … 6=domingo
  dayOfWeek  Int
  startTime  String
  /// Si es null, usa Service.capacity.
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, dayOfWeek, startTime])
  @@index([businessId])
  @@index([businessId, serviceId])
  @@map("class_templates")
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  externalId   String?
  name         String?
  email        String?
  phone        String?
  notes        String?
  statusId     String   @default("status-activo")
  status       ClientStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  hasUsedTrial Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  memories      Memory[]
  leads         Lead[]
  appointments  Appointment[]
  payments      Payment[]
  passes        ServicePass[]
  movements     ClassCreditMovement[]

  @@index([businessId])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@index([businessId, statusId])
  @@map("users")
}

model ClientStatus {
  id        String @id
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  users     User[]

  @@map("client_statuses")
}

model Payment {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  passId            String?
  pass              ServicePass? @relation(fields: [passId], references: [id], onDelete: SetNull)
  amount            Decimal  @db.Decimal(12, 2)
  paidAt            DateTime
  notes             String?
  sessionsGranted   Int      @default(0)
  sessionsConsumed  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId, paidAt])
  @@index([businessId, userId])
  @@index([businessId, serviceId])
  @@map("payments")
}

/// Pack comprado por un cliente para un servicio (clases pagadas vs usadas).
model ServicePass {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sessionCount  Int
  sessionsPaid  Int      @default(0)
  sessionsUsed  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE|COMPLETED|CANCELLED
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
  movements     ClassCreditMovement[]
  appointments  Appointment[]

  @@index([businessId, userId])
  @@index([businessId, userId, serviceId])
  @@map("service_passes")
}

model Conversation {
  id                 String    @id @default(uuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentConfigId      String?
  agentConfig        AgentConfig? @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel            String    @default("WEB")
  status             String    @default("AI")
  externalId         String?
  contactName        String?
  contactUsername    String?
  contactPhone       String?
  contactAvatarUrl   String?
  unreadCount        Int       @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastMessageSender  String?
  metadata           Json?
  summary            String?
  /// Oculta de la bandeja (eliminar). Un mensaje nuevo del cliente la vuelve a mostrar.
  hiddenAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages        Message[]
  memories        Memory[]
  agentExecutions AgentExecution[]
  appointments    Appointment[]
  leads           Lead[]
  followUps       LeadFollowUp[]

  @@index([businessId, status])
  @@index([businessId, userId])
  @@index([businessId, lastMessageAt])
  @@index([businessId, channel, externalId])
  @@index([businessId, hiddenAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  businessId     String
  role           String
  /// CLIENT | AI | HUMAN | TOOL | SYSTEM — para UI / bandeja
  sender         String       @default("CLIENT")
  content        String
  /// wamid u otro id externo del canal
  externalId     String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  toolCalls      Json?
  toolCallId     String?
  status         String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@unique([businessId, externalId])
  @@index([conversationId, createdAt])
  @@index([businessId])
  @@map("messages")
}

model WhatsAppConfig {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// waha | meta_cloud
  provider           String   @default("waha")
  /// WAHA base URL, e.g. http://localhost:3002
  wahaBaseUrl        String?
  wahaApiKeyEnc      String?
  sessionName        String   @default("default")
  /// Meta Cloud (futuro / legacy)
  phoneNumberId      String?
  businessAccountId  String?
  displayPhoneNumber String?
  verifyToken        String?
  accessTokenEnc     String?
  /// WAHA me.id e.g. 54911...@c.us
  meId               String?
  enabled            Boolean  @default(false)
  /// Si false, el canal queda conectado al inbox pero el agente no responde.
  agentEnabled       Boolean  @default(true)
  /// disconnected | connecting | scan_qr | connected | error
  status             String   @default("disconnected")
  /// Estado crudo de WAHA: STOPPED | STARTING | SCAN_QR_CODE | WORKING | FAILED
  sessionStatus      String?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("whatsapp_configs")
}

model GoogleCalendarConfig {
  id              String    @id @default(uuid())
  businessId      String    @unique
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calendarId      String    @default("primary")
  refreshTokenEnc String?
  enabled         Boolean   @default(false)
  /// disconnected | connected | error
  status          String    @default("disconnected")
  lastError       String?
  connectedEmail  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("google_calendar_configs")
}

/// Widget de chat embebido (landing). La API key se guarda hasheada.
model WebChatConfig {
  id             String    @id @default(uuid())
  businessId     String    @unique
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled        Boolean   @default(false)
  /// SHA-256 hex de la API key del widget
  apiKeyHash     String?   @unique
  /// Prefijo visible, p.ej. nlw_a1b2c3d4
  apiKeyPrefix   String?
  /// Orígenes CORS permitidos (https://midominio.com). Vacío = cualquier origen (la key sigue siendo obligatoria).
  allowedOrigins String[]  @default([])
  /// disconnected | connected
  status         String    @default("disconnected")
  lastError      String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("web_chat_configs")
}

/// Cita local (fuente de verdad del negocio). Se sincroniza con Google Calendar si está conectado.
model Appointment {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  servicePassId  String?
  servicePass    ServicePass?  @relation(fields: [servicePassId], references: [id], onDelete: SetNull)
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  /// pending | confirmed | cancelled | completed
  status         String        @default("confirmed")
  isTrial        Boolean       @default(false)
  googleEventId  String?
  notes          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reminderLogs   AppointmentReminderLog[]
  movements      ClassCreditMovement[]

  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([businessId, contactPhone])
  @@index([businessId, userId])
  @@map("appointments")
}

/// Recordatorios automáticos de citas (WhatsApp / email / Instagram).
model AppointmentReminderConfig {
  id          String   @id @default(uuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  /// Horas antes de startsAt (1–24).
  hoursBefore Int      @default(24)
  /// Orden de preferencia: whatsapp | email | instagram
  channels    String[] @default(["whatsapp", "email", "instagram"])
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("appointment_reminder_configs")
}

model AppointmentReminderLog {
  id            String      @id @default(uuid())
  businessId    String
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hoursBefore   Int
  /// whatsapp | email | instagram | none
  channel       String
  /// pending | sent | failed | skipped
  status        String
  error         String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId])
  @@index([businessId, status])
  @@map("appointment_reminder_logs")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents    Document[]
  agentConfigs AgentConfig[]

  @@index([businessId])
  @@map("knowledge_bases")
}

model Document {
  id              String        @id @default(uuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  businessId      String
  title           String
  source          String
  /// Texto editable (FAQ / notas). Los archivos subidos también lo rellenan al ingest.
  content         String?
  mimeType        String?
  category        String?
  status          String        @default("pending")
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chunks DocumentChunk[]

  @@index([businessId])
  @@index([knowledgeBaseId])
  @@map("documents")
}

model DocumentChunk {
  id         String                      @id @default(uuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  businessId String
  content    String
  page       Int?
  category   String?
  source     String?
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime                    @default(now())

  @@index([businessId])
  @@index([documentId])
  @@map("document_chunks")
}

model ToolConfig {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  enabled             Boolean  @default(true)
  risk                String   @default("READ")
  requireConfirmation Boolean  @default(false)
  settings            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([businessId, name])
  @@map("tool_configs")
}

model Integration {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  name       String
  enabled    Boolean  @default(true)
  config     Json
  secretsEnc String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, type])
  @@map("integrations")
}

model Automation {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  webhookUrl  String
  enabled     Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@map("automations")
}

model Memory {
  id             String                      @id @default(uuid())
  businessId     String
  business       Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?               @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           String
  key            String?
  content        String
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([businessId, userId])
  @@index([conversationId])
  @@map("memories")
}

model AgentExecution {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider       String
  model          String
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  estimatedCost  Float        @default(0)
  durationMs     Int
  steps          Int
  success        Boolean
  error          String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  toolExecutions ToolExecution[]

  @@index([businessId, createdAt])
  @@index([conversationId])
  @@map("agent_executions")
}

model ToolExecution {
  id               String         @id @default(uuid())
  agentExecutionId String?
  agentExecution   AgentExecution? @relation(fields: [agentExecutionId], references: [id], onDelete: SetNull)
  businessId       String
  conversationId   String?
  tool             String
  input            Json
  output           Json?
  durationMs       Int
  success          Boolean
  error            String?
  idempotencyKey   String?
  createdAt        DateTime       @default(now())

  @@index([businessId, tool])
  @@index([idempotencyKey])
  @@map("tool_executions")
}

model Lead {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  name              String?
  email             String?
  phone             String?
  message           String?
  source            String?
  metadata          Json?
  /// new | contacted | interested | won | lost | inactive
  status            String        @default("new")
  interest          String?
  objections        String?
  preferredChannel  String?
  convertedAt       DateTime?
  conversionSource  String?
  lastContactedAt   DateTime?
  lastInboundAt     DateTime?
  lostReason        String?
  isContactable     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  events            LeadEvent[]
  followUps         LeadFollowUp[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, isContactable])
  @@map("leads")
}

/// Config 1:1 de lifecycle / follow-up (mismo patrón que AppointmentReminderConfig).
model LeadLifecycleConfig {
  id                         String   @id @default(uuid())
  businessId                 String   @unique
  business                   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  followUpEnabled            Boolean  @default(false)
  /// manual | suggested | automatic
  conversionMode             String   @default("manual")
  conversionTriggers         String[] @default([])
  followUpDelaysHours        Int[]    @default([24, 72, 168])
  maxAttempts                Int      @default(3)
  generateWithAi             Boolean  @default(true)
  /// auto | review | reminder_only
  sendMode                   String   @default("reminder_only")
  quietHoursStart            String   @default("09:00")
  quietHoursEnd              String   @default("21:00")
  timezone                   String?
  /// auto | whatsapp | email | instagram | facebook
  preferredChannel           String   @default("auto")
  askForMissingContact       Boolean  @default(true)
  convertedClientStatusSlug  String   @default("activo")
  trialClientStatusSlug      String   @default("visita")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("lead_lifecycle_configs")
}

/// Avisos por email al negocio cuando hay operaciones sensibles (agenda, leads, clientes).
model AdminNotifyConfig {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(false)
  emails     String[] @default([])
  /// appointment.created | appointment.cancelled | appointment.rescheduled | lead.created | client.auto_created
  events     String[] @default(["appointment.created", "lead.created", "client.auto_created"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_notify_configs")
}

model LeadFollowUp {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// auto | manual | agent
  source         String
  objective      String
  objectiveNote  String?
  /// pending | generating | review | sent | cancelled | failed | skipped
  status         String        @default("pending")
  scheduledAt    DateTime
  attemptNumber  Int           @default(1)
  channel        String?
  draftMessage   String?
  sentMessage    String?
  sentAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, status, scheduledAt])
  @@index([leadId, status])
  @@map("lead_follow_ups")
}

model LeadEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String
  payload    Json?
  /// agent | admin | system
  actor      String   @default("system")
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([businessId])
  @@map("lead_events")
}

/// Identidad visual / voz de marca para el Content Agent.
model BrandingConfig {
  id                   String   @id @default(uuid())
  businessId           String   @unique
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logoUrl              String?
  primaryColor         String?
  secondaryColor       String?
  visualStyle          String?
  commercialTone       String?
  targetAudience       String?
  preferNotes          String?
  avoidNotes           String?
  additionalInstructions String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("branding_configs")
}

/// Preferencias y límites del creador de contenido.
model SocialContentConfig {
  id                     String   @id @default(uuid())
  businessId             String   @unique
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultChannels        String[] @default([])
  maxGenerationsPerDay   Int      @default(20)
  maxGenerationsPerMonth Int      @default(200)
  preferredObjectives    String[] @default([])
  /// Generación automática programada
  autoGenerateEnabled    Boolean  @default(false)
  /// Luxon weekday: 1=lunes … 7=domingo. Vacío = todos los días.
  autoGenerateDaysOfWeek Int[]    @default([])
  /// HH:mm en timezone del negocio
  autoGenerateTime       String   @default("10:00")
  /// Canales para piezas automáticas (si vacío → defaultChannels)
  autoGenerateChannels   String[] @default([])
  autoGenerateObjective  String   @default("AUTOMATIC")
  lastAutoGenerateAt     DateTime?
  /// Aviso por WhatsApp cuando hay sesión conectada (código de país, solo dígitos)
  notifyWhatsAppPhone    String?
  /// Aviso por email si WhatsApp no está conectado o falla el envío
  notifyEmail            String?
  /// Video: provider y modelo por negocio (si vacío → env VIDEO_PROVIDER / KIE_VIDEO_MODEL)
  preferredVideoProvider String?
  preferredVideoModel    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("social_content_configs")
}

/// Pieza de contenido generada (manual o automática).
model GeneratedContent {
  id                 String   @id @default(uuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId          String?
  service            Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// AUTOMATIC | SERVICE_PROMOTION | OFFER | TIP | INFO | SPECIAL_DATE | CUSTOM
  objective          String
  topic              String?
  headline           String?
  /// Texto de overlay al inicio del video (no se publica como caption).
  hook               String?
  caption            String?
  cta                String?
  hashtags           String[] @default([])
  userInstructions   String?
  /// URLs de imágenes de referencia subidas por el usuario (contexto para strategy + image gen)
  referenceImageUrls String[] @default([])
  strategy           Json?
  imagePrompt        String?
  videoPrompt        String?
  visualStyle        String?
  /// IMAGE | VIDEO
  mediaType          String   @default("IMAGE")
  /// Duración del short en segundos (5 | 10 | 15). Null en imágenes.
  durationSeconds    Int?
  /// Canales destino: WHATSAPP_STATUS | INSTAGRAM_STORY | INSTAGRAM_FEED | INSTAGRAM_REEL | TIKTOK
  channels           String[] @default([])
  /// DRAFT | READY | GENERATING | SCHEDULED | PUBLISHING | PUBLISHED | PARTIALLY_PUBLISHED | FAILED
  status             String   @default("DRAFT")
  /// PROCESSING | COMPLETED | SKIPPED | FAILED — postproducción FFmpeg (solo VIDEO)
  autoEditStatus     String?
  autoEditError      String?
  /// MANUAL | AUTOMATIC
  generationMode     String   @default("MANUAL")
  error              String?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assets      ContentAsset[]
  executions  ContentGenerationExecution[]
  publications ContentPublication[]
  audioAssets AudioAsset[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@map("generated_contents")
}

model ContentAsset {
  id               String   @id @default(uuid())
  contentId        String
  content          GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  /// IMAGE | VIDEO
  type             String   @default("IMAGE")
  /// ORIGINAL | EDITED
  role             String   @default("ORIGINAL")
  /// STORY_VERTICAL | SHORT_VERTICAL | FEED_SQUARE | FEED_PORTRAIT | FEED_LANDSCAPE
  format           String
  aspectRatio      String?
  width            Int?
  height           Int?
  storageUrl       String
  storagePublicId  String?
  provider         String?
  model            String?
  generationPrompt String?
  generationCost   Decimal? @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  @@index([contentId])
  @@map("content_assets")
}

model AudioAsset {
  id              String   @id @default(uuid())
  contentId       String
  content         GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider        String   // seedance | elevenlabs
  voiceId         String?
  voiceName       String?
  text            String?
  model           String?
  storageUrl      String?
  storagePublicId String?
  durationSeconds Float?
  status          String   @default("COMPLETED") // PENDING | PROCESSING | COMPLETED | FAILED
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contentId])
  @@index([businessId])
  @@map("audio_assets")
}

model ContentPublication {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentId   String
  content     GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  /// WHATSAPP_STATUS | INSTAGRAM_STORY | INSTAGRAM_FEED | INSTAGRAM_REEL | TIKTOK
  channel     String
  /// PENDING | PUBLISHING | PUBLISHED | FAILED
  status      String   @default("PENDING")
  externalId  String?
  error       String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contentId])
  @@index([businessId, channel])
  @@map("content_publications")
}

model ContentGenerationExecution {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentId       String?
  content         GeneratedContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  stage           String
  provider        String?
  model           String?
  success         Boolean  @default(false)
  error           String?
  inputTokens     Int?
  outputTokens    Int?
  estimatedCost   Decimal? @db.Decimal(12, 6)
  durationMs      Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([contentId])
  @@map("content_generation_executions")
}

/// Cuentas sociales de publicación (Instagram / Facebook / TikTok vía Zernio).
/// No guarda tokens de Meta/TikTok: la API key de Zernio vive en env.
model SocialConnection {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// zernio (futuros: meta, etc.)
  provider          String   @default("zernio")
  /// instagram | tiktok | facebook
  platform          String
  /// Account `_id` en Zernio
  externalAccountId String
  zernioProfileId   String
  username          String?
  displayName       String?
  avatarUrl         String?
  /// connected | disconnected | revoked | error
  status            String   @default("connected")
  /// Si false, Instagram/Messenger reciben inbox pero el agente no responde.
  agentEnabled      Boolean  @default(true)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([businessId, provider, platform])
  @@unique([provider, externalAccountId])
  @@index([businessId, platform])
  @@index([zernioProfileId])
  @@map("social_connections")
}

/// Usuarios del panel admin (login local, no confundir con User/contacto).
model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  /// ADMIN | USER
  role         String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

