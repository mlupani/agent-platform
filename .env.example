# =============================================================================
# Template single-business: 1 clone = 1 negocio = 1 DB = 1 deploy
# Copiá a .env y completá los secretos. Nunca commitees .env real.
# =============================================================================

# App
NODE_ENV=development
API_PORT=3001
# URL pública de la API (sin /api al final en API_URL; el prefix /api lo pone Nest)
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000
ADMIN_API_KEY=change-me-admin-api-key

# Login del panel (usuario/pass hasheado en DB; se crean al arrancar si no existen)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_USER_USERNAME=negocio
AUTH_USER_PASSWORD=negocio123

# Admin (Next.js) — también se usan como build-args de Docker
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Opcional: legacy para scripts; el panel ya no lo necesita en el browser
# NEXT_PUBLIC_ADMIN_API_KEY=
# Email mostrado en el header del admin (opcional, fallback)
NEXT_PUBLIC_ADMIN_EMAIL=admin@negocio.local
# Fallbacks server-side (mismo valor)
API_URL_INTERNAL=http://localhost:3001/api

# Database
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (requerido para chat + embeddings RAG)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Creador de contenido — generación de imágenes
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
# Vision para strategy cuando hay imágenes de referencia
CONTENT_VISION_MODEL=gpt-4.1-mini

# Creador de contenido — generación de video / shorts
# Primary: kie.ai (bajo costo). Fallback: fal.ai si kie está saturado.
VIDEO_PROVIDER=kie
VIDEO_FALLBACK_PROVIDER=fal
VIDEO_FALLBACK_ENABLED=true
VIDEO_DURATION_SECONDS=5
# 5 | 10 | 15 — el panel puede overridear por pieza. Seedance (kie) máx 12s.
VIDEO_ASPECT_RATIO=9:16
VIDEO_RESOLUTION=720p
VIDEO_GENERATE_AUDIO=false
VIDEO_TIMEOUT_MS=720000
VIDEO_POLL_INTERVAL_MS=5000
# kie.ai — https://kie.ai/api-key
KIE_API_KEY=
KIE_API_URL=https://api.kie.ai
KIE_VIDEO_MODEL=bytedance/seedance-1.5-pro
KIE_VIDEO_ESTIMATED_COST=0.08
# fal.ai — https://fal.ai/dashboard/keys (FAL_KEY = key_id:key_secret)
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video
FAL_VIDEO_ESTIMATED_COST=0.18

# Cloudinary (storage de assets del creador de contenido)
# Opción A: URL completa
CLOUDINARY_URL=
# Opción B: campos sueltos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz en Media Library (default: cloud-platform)
CLOUDINARY_FOLDER=cloud-platform

# LLM routing del agente:
# - openai (default): usa AgentConfig (OpenAI) y si falla → Gemini
# - free: fuerza Gemini (ideal para pruebas sin gastar tokens OpenAI)
AGENT_LLM_MODE=openai
AGENT_LLM_FALLBACK_ENABLED=true
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest

# Encryption for integration secrets (mín. 32 chars)
ENCRYPTION_KEY=change-me-to-a-long-random-secret-32chars

# Email transaccional (avisos de contenido, confirmaciones del agente)
# EMAIL_PROVIDER=smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="Negocio <tu-correo@gmail.com>"
# EMAIL_REPLY_TO=hola@tudominio.com
RESEND_API_KEY=
# Gmail: smtp.gmail.com + contraseña de aplicación (no la clave normal)
# Outlook: smtp.office365.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=

# Optional LLM providers
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# n8n (optional)
N8N_WEBHOOK_TIMEOUT_MS=15000

# WhatsApp via WAHA (https://waha.devlike.pro/)
# Flujo: WhatsApp → WAHA → Nest (/api/webhooks/waha) → Agent → WAHA → WhatsApp
# Dashboard recibe estado/QR/mensajes por WebSocket (/realtime), no habla con WAHA.
#
# Local (API en el host): http://localhost:3002
# Docker Compose fuerza WAHA_BASE_URL=http://waha:3000 dentro del contenedor api
WAHA_BASE_URL=http://localhost:3002
WAHA_API_KEY=00000000000000000000000000000000
# NOWEB recomendado (WEBJS rompe Status). Al cambiar de motor hay que re-escanear QR.
WHATSAPP_DEFAULT_ENGINE=NOWEB
# URL que WAHA llama hacia Nest (desde el contenedor waha → api)
WAHA_WEBHOOK_URL=http://api:3001/api/webhooks/waha
# Legacy Meta (opcional / futuro MetaCloudProvider)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

# Instagram Direct via aiograpi-rest (https://github.com/subzeroid/aiograpi-rest)
# Local (API en el host): exponer temporalmente el puerto 8000 o usar docker network
# Docker Compose fuerza INSTAGRAM_API_URL=http://instagram:8000 dentro del contenedor api
INSTAGRAM_API_URL=http://localhost:8000
# Polling de DMs (aiograpi-rest no expone webhooks/WebSocket). Recomendado 8000–15000.
INSTAGRAM_SYNC_INTERVAL_MS=8000

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con la URL autorizada en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# -----------------------------------------------------------------------------
# Docker Compose (stack completo)
# - Postgres/Redis internos usan hostnames postgres/redis (override en compose)
# - NEXT_PUBLIC_* debe apuntar a URLs alcanzables desde el navegador del usuario
# -----------------------------------------------------------------------------
