{
  "name": "agent-platform",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api test:e2e",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:deploy": "pnpm --filter api prisma:deploy",
    "db:seed": "pnpm --filter api prisma:seed --",
    "db:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up -d --build",
    "docker:infra": "docker compose up -d postgres redis waha",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api admin waha",
    "docker:seed": "docker compose exec api pnpm prisma:seed --"
  }
}
